{
  "name": "zotero-ai-reader",
  "type": "module",
  "version": "1.0.0",
  "description": "AI-powered reading assistant for Zotero with translation, explanation, and context-aware dialogue",
  "config": {
    "addonName": "Zotero AI Reader",
    "addonID": "zotero-ai-reader@claude.ai",
    "addonRef": "zoteroAIR",
    "addonInstance": "ZoteroAIR",
    "prefsPrefix": "extensions.zotero.zoteroAIR"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhtdark1999-create/ThdomtDeng.git"
  },
  "author": "Developer",
  "bugs": {
    "url": "https://github.com/dhtdark1999-create/ThdomtDeng/issues"
  },
  "homepage": "https://github.com/dhtdark1999-create/ThdomtDeng#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "vitest run",
    "update-deps": "npm update --save",
    "test:e2e": "zotero-plugin build && node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "happy-dom": "21.0.4",
    "jszip": "3.10.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "5.0.5",
    "zotero-plugin-scaffold": "^0.3.5",
    "zotero-types": "^3.1.9"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
